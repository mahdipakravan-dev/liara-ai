# ── Liara AI (required) ───────────────────────────────────────────────────────
# Without all three, /api/chat answers 503 and the rest of the console still works.
# All three are read on the server only. Never prefix them with NEXT_PUBLIC_.

# OpenAI-compatible base URL supplied by the Liara AI service.
LIARA_AI_BASE_URL=https://ai.liara.ir/api/v1/<workspace-id>

# Server-only API key.
LIARA_AI_API_KEY=

# Exact model identifier enabled for your account, e.g. z-ai/glm-5.3
LIARA_AI_MODEL=

# ── Optional ──────────────────────────────────────────────────────────────────
# Structured log verbosity: debug | info | warn | error. Defaults to info.
LOG_LEVEL=info
